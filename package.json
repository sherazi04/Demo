{
  "name": "dual-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Metadata-Driven Dual-Engine Personalized Learning Framework for Outcome-Based Education",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:local": "tsx scripts/local-db.ts",
    "seed:curriculum": "tsx scripts/seed-curriculum.ts",
    "seed:users": "tsx scripts/seed-users.ts",
    "seed:demo": "tsx scripts/seed-demo-content.ts",
    "seed:cohort": "tsx scripts/seed-cohort.ts",
    "seed:accounts": "tsx scripts/seed-demo-accounts.ts",
    "sync:kg": "tsx scripts/sync-kg.ts",
    "ingest": "tsx scripts/ingest.ts",
    "verify:chain": "tsx scripts/verify-chain.ts",
    "verify:schema": "tsx scripts/verify-schema.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "smoke:analytics": "tsx scripts/smoke-analytics.ts",
    "smoke:ingest": "tsx scripts/smoke-ingest.ts",
    "smoke:http": "tsx scripts/smoke-http.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "bootstrap": "npm run db:migrate && npm run seed:curriculum && npm run sync:kg && npm run seed:users",
    "demo:seed": "npm run seed:demo && npm run seed:cohort && npm run seed:accounts",
    "verify": "npm run typecheck && npm run test && npm run verify:schema && npm run smoke && npm run smoke:ingest && npm run smoke:analytics && npm run verify:chain",
    "eval": "tsx eval/report.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.38.3",
    "ioredis": "^5.4.2",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.9.0",
    "neo4j-driver": "^5.27.0",
    "next": "^15.1.4",
    "next-auth": "^5.0.0-beta.25",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "unpdf": "^0.12.1",
    "unzipper": "^0.12.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-pgvector": "^0.0.5",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "@types/unzipper": "^0.10.10",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
