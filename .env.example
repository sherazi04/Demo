# ─────────────────────────────────────────────────────────────────────────────
# Dual-Engine Personalized Learning Framework — environment configuration
# Copy to `.env` and adjust. Every variable here is validated by src/lib/env.ts.
# Anything runtime-configurable from the admin panel (NFR-CFG-001..005) is
# stored in `system_config` and falls back to the values below.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=dualengine
POSTGRES_PASSWORD=dualengine
POSTGRES_DB=dualengine
POSTGRES_PORT=5433
DATABASE_URL=postgresql://dualengine:dualengine@localhost:5433/dualengine
# Pool size. Keep 10 for Docker/real Postgres; the local PGlite dev database
# (npm run db:local) accepts one connection, so set this to 1 when using it.
DATABASE_POOL_MAX=10

# ── Neo4j ────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=dualengine
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ── Redis / BullMQ ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
INGEST_CONCURRENCY=2

# ── Auth (NFR-SEC-001) ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-32-byte-random-string
AUTH_TRUST_HOST=true
BCRYPT_ROUNDS=12

# Bootstrap admin, created once on first run of `npm run seed:users` (FR-ADM-001).
BOOTSTRAP_ADMIN_EMAIL=admin@example.edu
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2025
BOOTSTRAP_ADMIN_NAME=System Administrator

# ── Anthropic (LLM) ──────────────────────────────────────────────────────────
# Exact model strings, never with a date suffix.
ANTHROPIC_API_KEY=
LLM_MODEL_GENERATION=claude-opus-5
LLM_MODEL_JUDGE=claude-opus-5
LLM_MODEL_BULK=claude-opus-5
LLM_EFFORT_GENERATION=high
LLM_EFFORT_JUDGE=high
LLM_EFFORT_BULK=low
LLM_MAX_TOKENS=16000
LLM_MAX_TOKENS_STREAMING=64000
LLM_SCHEMA_RETRIES=2
LLM_TIMEOUT_MS=180000
LLM_MAX_RETRIES=3

# ── Embeddings (FR-INT-045: `local` needs no key and no network) ─────────────
# voyage | openai | local
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=1024
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Chunking (NFR-CFG-004) ───────────────────────────────────────────────────
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_TOKENS=60
CHUNK_MIN_TOKENS=80

# ── Retrieval (NFR-CFG-003) ──────────────────────────────────────────────────
RETRIEVAL_VECTOR_K=40
RETRIEVAL_LEXICAL_K=25
RETRIEVAL_GRAPH_HOPS=1
RETRIEVAL_GRAPH_K=15
RETRIEVAL_FINAL_K=8
RRF_K=60
RRF_GRAPH_RANK_PENALTY=8
RERANK_ENABLED=false

# ── Validation (NFR-CFG-005) ─────────────────────────────────────────────────
ENFORCE_VALIDATION=true
CLO_ALIGN_THRESHOLD=0.75
GROUNDEDNESS_THRESHOLD=0.8
DISTRACTOR_THRESHOLD=0.7

# ── Student engine (design.md §8) ────────────────────────────────────────────
BKT_P_INIT=0.15
BKT_P_TRANSIT=0.12
BKT_P_SLIP=0.10
BKT_SAQ_P_GUESS=0.05
MASTERY_THRESHOLD=0.7
MASTERY_HIGH=0.85
ELO_K_EARLY=0.03
ELO_K_LATE=0.01
ELO_SERVED_SWITCH=30

# ── Governance ───────────────────────────────────────────────────────────────
AUDIT_CHAIN_SEED=dual-engine-genesis
BIAS_DEVIATION_THRESHOLD=0.15

# ── Uploads (NFR-SEC-003: stored outside the web root) ───────────────────────
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=104857600
